{
  "name": "AI Document Processor (Invoices & Receipts)",
  "nodes": [
    {
      "id": "5156a994-b476-4dae-b703-3317abf5738f",
      "name": "Document Form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        112
      ],
      "parameters": {
        "formTitle": "Demo Accounting — загрузка документов",
        "formDescription": "Загрузите счёт, чек или акт (PDF или фото). AI сам вытащит поставщика, суммы, даты и проверит ошибки.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Ваше имя",
              "fieldName": "uploader",
              "fieldType": "text",
              "placeholder": "Анна",
              "requiredField": true
            },
            {
              "fieldLabel": "Тип документа",
              "fieldName": "doc_type",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Счёт (invoice)"
                  },
                  {
                    "option": "Чек"
                  },
                  {
                    "option": "Акт / договор"
                  },
                  {
                    "option": "Не знаю"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Файл (PDF, JPG, PNG)",
              "fieldName": "document",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".pdf,.jpg,.jpeg,.png,.webp",
              "requiredField": true
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Обработать документ",
          "path": "doc-ai-demo",
          "ignoreBots": true
        }
      }
    },
    {
      "id": "32dd541d-507d-436d-a2be-d2eb3a58d311",
      "name": "Normalize File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const bin = $input.item.binary || {};\nconst key = Object.keys(bin)[0];\nif (!key) throw new Error('Файл не загружен');\nconst f = bin[key];\nconst mime = f.mimeType || '';\nconst name = f.fileName || 'document';\nconst kind = (mime.includes('pdf') || name.toLowerCase().endsWith('.pdf')) ? 'pdf' : 'image';\nreturn {\n  json: {\n    uploader: $json.uploader || '',\n    docHint: $json.doc_type || 'Не знаю',\n    fileName: name,\n    mimeType: mime,\n    kind,\n    uploadedAt: $json.submittedAt || new Date().toISOString()\n  },\n  binary: { data: f }\n};"
      },
      "notes": "Why Code: the form names the binary key after the field (document / document_0); this renames it to \"data\" and detects PDF vs image."
    },
    {
      "id": "ff164c78-884d-4209-83ec-0b509dd4920d",
      "name": "PDF or Photo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        448,
        112
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.kind }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "pdf"
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "3d48c9b0-5716-4d73-987a-74896e5d087e",
      "name": "Read PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        672,
        16
      ],
      "parameters": {
        "operation": "pdf",
        "options": {
          "joinPages": true,
          "maxPages": 10
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "b083c6e4-1e97-4d93-ace9-34c6e77cb326",
      "name": "PDF Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        896,
        16
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "p1",
              "name": "text",
              "value": "={{ $json.text || \"\" }}",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "id": "feb668a0-76e6-41ba-bb1d-5da9f0e81d52",
      "name": "AI Extract Data",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        1120,
        112
      ],
      "parameters": {
        "promptType": "define",
        "hasOutputParser": true,
        "text": "=File: {{ $('Normalize File').item.json.fileName }}\nUser says the document type is: {{ $('Normalize File').item.json.docHint }}\nToday: {{ $now.toFormat('yyyy-MM-dd') }}\n\nDocument text:\n{{ ($json.text || '').slice(0, 15000) }}",
        "messages": {
          "messageValues": [
            {
              "type": "SystemMessagePromptTemplate",
              "message": "You are an accounting assistant. Extract data from an invoice, receipt, act or contract (Russian, Armenian or English).\nRules:\n- doc_type: one of invoice, receipt, act, contract, other.\n- Dates in YYYY-MM-DD. If missing use \"\".\n- currency: ISO code (AMD, USD, EUR, RUB). Armenian dram (֏, драм, դրամ) = AMD.\n- subtotal, tax, total: numbers without spaces or symbols. If missing use 0. Never invent numbers. On receipts VAT is usually already included in the total (\"в т.ч. НДС\"); then subtotal = 0.\n- items: every line item with name, qty, price, sum (numbers). Empty array if none.\n- summary: one short sentence in Russian: who, what, how much, until when.\n- issues: short list in Russian of REAL problems only: items do not add up to the total, unreadable parts, missing vendor or tax ID, the text is empty or not a document. Do not report a missing subtotal, missing due date on a receipt, or guesses about causes. One problem = one line. Empty array if everything is fine."
            }
          ]
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "0b188e36-9986-4eca-a016-bb6087035e4a",
      "name": "OpenAI Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        1136,
        336
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {
          "maxTokens": 4000,
          "reasoningEffort": "low"
        }
      }
    },
    {
      "id": "2a700f14-7093-4416-888e-4e51bd975223",
      "name": "Document Format",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1264,
        336
      ],
      "parameters": {
        "schemaType": "fromJson",
        "jsonSchemaExample": "{\"doc_type\":\"invoice\",\"vendor\":\"ООО Пример\",\"doc_number\":\"INV-102\",\"doc_date\":\"2026-11-10\",\"due_date\":\"2026-11-25\",\"currency\":\"AMD\",\"subtotal\":100000,\"tax\":20000,\"total\":120000,\"items\":[{\"name\":\"Обслуживание сайта\",\"qty\":1,\"price\":100000,\"sum\":100000}],\"summary\":\"Счёт от ООО Пример на 120 000 AMD за обслуживание сайта, оплатить до 25.11.\",\"issues\":[\"Не указан ИНН поставщика\"]}"
      }
    },
    {
      "id": "0850db23-890c-4722-8439-c8833a04c651",
      "name": "Read Photo (Vision)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        672,
        208
      ],
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "id",
          "value": "gpt-4.1-mini"
        },
        "text": "Transcribe ALL text from this document photo exactly as written, line by line, keeping numbers, dates and currency symbols. Do not summarize. If it is not a document, say NOT_A_DOCUMENT.",
        "inputType": "base64",
        "binaryPropertyName": "data",
        "simplify": true,
        "options": {
          "detail": "high",
          "maxTokens": 3000
        }
      },
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000
    },
    {
      "id": "70f98ee3-7299-488e-801a-565c455d3338",
      "name": "Photo Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        896,
        208
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "i1",
              "name": "text",
              "value": "={{ $json.content || $json.text || '' }}",
              "type": "string"
            }
          ]
        }
      }
