    {
      "id": "2750a66e-d68d-4214-a043-d30e5a11d19d",
      "name": "Check Numbers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1472,
        112
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const o = $json.output || {};\nconst aiFailed = !$json.output;\nconst src = $('Normalize File').item.json;\nconst today = $now.toFormat('yyyy-MM-dd');\nconst num = v => Number(String(v ?? 0).replace(/[^0-9.\\-]/g, '')) || 0;\nconst esc = s => String(s ?? '').replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);\nconst items = Array.isArray(o.items) ? o.items : [];\nconst total = num(o.total), tax = num(o.tax), subtotal = num(o.subtotal);\nconst itemsSum = items.reduce((s, i) => s + num(i.sum), 0);\nconst issues = Array.isArray(o.issues) ? [...o.issues] : [];\nif (aiFailed) issues.push('Документ не удалось разобрать автоматически, проверьте вручную');\nelse {\n  if (!o.vendor) issues.push('Не найден поставщик');\n  if (!o.doc_number) issues.push('Нет номера документа');\n  if (!total) issues.push('Не найдена итоговая сумма');\n}\n// items may equal subtotal, total (VAT included, typical for receipts) or total minus tax\nif (itemsSum && total) {\n  const ok = [subtotal, total, total - tax].filter(x => x > 0).some(x => Math.abs(itemsSum - x) <= 1);\n  const aiSaidIt = issues.some(x => String(x).replace(/\\s/g, '').includes(String(itemsSum)));\n  if (!ok && !aiSaidIt) issues.push('Позиции дают ' + itemsSum + ', а итог в документе ' + total + ' (разница ' + Math.abs(total - itemsSum) + ')');\n}\nif (subtotal && total && tax && Math.abs(subtotal + tax - total) > 1 && Math.abs(subtotal - total) > 1) issues.push('Подытог + налог (' + (subtotal + tax) + ') не равно итогу (' + total + ')');\nif (/^\\d{4}-\\d{2}-\\d{2}$/.test(o.due_date || '') && o.due_date < today) issues.push('Срок оплаты уже прошёл (' + o.due_date + ')');\nconst uniq = [...new Set(issues.filter(Boolean))];\nconst itemsText = items.map((i, n) => (n + 1) + '. ' + (i.name || '?') + ' — ' + num(i.qty) + ' × ' + num(i.price) + ' = ' + num(i.sum)).join('\\n');\nconst status = uniq.length ? 'Нужна проверка' : 'OK';\nconst summary = o.summary || (aiFailed ? 'Автоматический разбор не удался.' : '');\nconst tgText = (status === 'OK' ? '✅ Документ обработан' : '⚠️ Документ требует проверки') + '\\n\\n'\n  + '📄 ' + esc(src.fileName) + ' (' + esc(o.doc_type || 'other') + ')\\n'\n  + '🏢 ' + esc(o.vendor || '—') + ' · № ' + esc(o.doc_number || '—') + '\\n'\n  + '📅 ' + esc(o.doc_date || '—') + ' · оплатить до ' + esc(o.due_date || '—') + '\\n'\n  + '💰 ' + total + ' ' + esc(o.currency || '') + ' (налог ' + tax + ')\\n\\n'\n  + '🧠 ' + esc(summary)\n  + (uniq.length ? '\\n\\nПроблемы:\\n' + uniq.map(x => '• ' + esc(x)).join('\\n') : '')\n  + '\\n\\n👤 Загрузил: ' + esc(src.uploader);\nreturn { json: {\n  fileName: src.fileName,\n  uploader: src.uploader,\n  uploadedAt: src.uploadedAt,\n  docType: o.doc_type || 'other',\n  vendor: o.vendor || '',\n  docNumber: o.doc_number || '',\n  docDate: o.doc_date || '',\n  dueDate: o.due_date || '',\n  currency: o.currency || '',\n  tax, total,\n  itemsText,\n  itemsCount: items.length,\n  summary,\n  issuesText: uniq.map(x => '• ' + x).join('\\n'),\n  issuesCount: uniq.length,\n  status,\n  tgText\n} };"
      },
      "notes": "Why Code: arithmetic checks (items vs subtotal, subtotal + tax vs total, overdue) and formatting the item list in one step."
    },
